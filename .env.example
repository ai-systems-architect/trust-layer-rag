# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id

# S3
S3_BUCKET=your-s3-bucket-name
S3_RAW_PREFIX=raw/
S3_PROCESSED_PREFIX=processed/

# RDS / pgvector
RDS_ENDPOINT=your-rds-endpoint.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=compliance
RDS_USER=your-db-user
RDS_PASSWORD=your-db-password

# Embedding — OpenAI
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
OPENAI_API_KEY=your-openai-api-key

# Generation — Bedrock
GENERATION_PROVIDER=bedrock
GENERATION_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_GUARDRAIL_ID=your-guardrail-id

# Cohere — re-ranking
COHERE_API_KEY=your-cohere-api-key
RERANK_MODEL=rerank-english-v3.0

# Langfuse — self-hosted
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=http://localhost:3000

# Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Retrieval
FAITHFULNESS_THRESHOLD=0.85
RETRIEVAL_PRECISION_THRESHOLD=0.50
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5

# Corpus — four federal sources (see docs/decision_log.md DL-011)
CORPUS_SOURCES=nist_800_53,nist_ai_rmf,nist_ai_600_1,fedramp_moderate_baseline
NIST_800_53_URL=https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r5.pdf
NIST_AI_RMF_URL=https://nvlpubs.nist.gov/nistpubs/ai/NIST.AI.100-1.pdf
NIST_AI_600_1_URL=https://nvlpubs.nist.gov/nistpubs/ai/NIST.AI.600-1.pdf
FEDRAMP_BASELINE_URL=https://www.fedramp.gov/rev5/documents-templates/
